# API base URL (default: http://127.0.0.1:8000)
REACT_APP_API_URL=http://127.0.0.1:8000

# Frontend URL for email link previews in dev (default: http://127.0.0.1:3000)
REACT_APP_FRONTEND_URL=http://127.0.0.1:3000

# Set to true to test auth flows without a backend (development only)
REACT_APP_MOCK_API=false
